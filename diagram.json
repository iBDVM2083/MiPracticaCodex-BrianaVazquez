// ===============================================
// Programadora: Briana Daniela Vazquez Muñoz
// Actividad: 4.5 Codex + Wokwi para simular prácticas Raspberry Pico W
// Descripción: Simulación de un sistema con Raspberry Pi Pico,
// teclado matricial 4x4 y control de LEDs mediante GPIO.
// ===============================================
{
  "version": 1, // Versión del proyecto en Wokwi
  "author": "Anderson Costa", // Autor del diseño
  "editor": "wokwi", // Editor utilizado

  "parts": [
    // ===== MICROCONTROLADOR =====
    { 
      "type": "wokwi-pi-pico", // Raspberry Pi Pico
      "id": "pico",
      "top": 118,
      "left": 348,
      "rotate": 90,
      "attrs": {}
    },

    // ===== RESISTENCIAS PULL-UP PARA EL KEYPAD =====
    {
      "type": "wokwi-resistor",
      "id": "rp1",
      "top": 349.55,
      "left": 19.2,
      "attrs": { "value": "1000" } // 1kΩ
    },
    {
      "type": "wokwi-resistor",
      "id": "rp2",
      "top": 368.75,
      "left": 19.2,
      "attrs": { "value": "1000" }
    },
    {
      "type": "wokwi-resistor",
      "id": "rp3",
      "top": 426.35,
      "left": 19.2,
      "attrs": { "value": "1000" }
    },
    {
      "type": "wokwi-resistor",
      "id": "rp4",
      "top": 397.55,
      "left": 19.2,
      "attrs": { "value": "1000" }
    },

    // ===== TECLADO MATRICIAL 4x4 =====
    { 
      "type": "wokwi-membrane-keypad",
      "id": "keypad1",
      "top": -30.8,
      "left": -13.6,
      "attrs": {}
    },

    // ===== LEDs (1–8 AZULES, A–D ROJOS) =====
    // Cada LED tiene su resistencia limitadora de 220Ω

    { "type": "wokwi-led", "id": "led1", "top": 20, "left": 420, "attrs": { "color": "blue", "label": "8" } },
    { "type": "wokwi-resistor", "id": "r1", "top": 90, "left": 415, "rotate": 90, "attrs": { "value": "220" } },

    { "type": "wokwi-led", "id": "led2", "top": 20, "left": 400, "attrs": { "color": "blue", "label": "7" } },
    { "type": "wokwi-resistor", "id": "r2", "top": 90, "left": 395, "rotate": 90, "attrs": { "value": "220" } },

    { "type": "wokwi-led", "id": "led3", "top": 20, "left": 380, "attrs": { "color": "blue", "label": "6" } },
    { "type": "wokwi-resistor", "id": "r3", "top": 90, "left": 375, "rotate": 90, "attrs": { "value": "220" } },

    { "type": "wokwi-led", "id": "led4", "top": 20, "left": 360, "attrs": { "color": "blue", "label": "5" } },
    { "type": "wokwi-resistor", "id": "r4", "top": 90, "left": 355, "rotate": 90, "attrs": { "value": "220" } },

    { "type": "wokwi-led", "id": "led5", "top": 20, "left": 340, "attrs": { "color": "blue", "label": "4" } },
    { "type": "wokwi-resistor", "id": "r5", "top": 90, "left": 335, "rotate": 90, "attrs": { "value": "220" } },

    { "type": "wokwi-led", "id": "led6", "top": 20, "left": 320, "attrs": { "color": "blue", "label": "3" } },
    { "type": "wokwi-resistor", "id": "r6", "top": 90, "left": 315, "rotate": 90, "attrs": { "value": "220" } },

    { "type": "wokwi-led", "id": "led7", "top": 20, "left": 300, "attrs": { "color": "blue", "label": "2" } },
    { "type": "wokwi-resistor", "id": "r7", "top": 90, "left": 295, "rotate": 90, "attrs": { "value": "220" } },

    { "type": "wokwi-led", "id": "led8", "top": 20, "left": 280, "attrs": { "color": "blue", "label": "1" } },
    { "type": "wokwi-resistor", "id": "r8", "top": 90, "left": 275, "rotate": 90, "attrs": { "value": "220" } },

    // LEDs rojos (A, B, C, D)
    { "type": "wokwi-led", "id": "led9", "top": 20, "left": 440, "attrs": { "color": "red", "label": "A" } },
    { "type": "wokwi-resistor", "id": "r9", "top": 90, "left": 435, "rotate": 90, "attrs": { "value": "220" } },

    { "type": "wokwi-led", "id": "led10", "top": 20, "left": 460, "attrs": { "color": "red", "label": "B" } },
    { "type": "wokwi-resistor", "id": "r10", "top": 90, "left": 455, "rotate": 90, "attrs": { "value": "220" } },

    { "type": "wokwi-led", "id": "led11", "top": 20, "left": 480, "attrs": { "color": "red", "label": "C" } },
    { "type": "wokwi-resistor", "id": "r11", "top": 90, "left": 475, "rotate": 90, "attrs": { "value": "220" } },

    { "type": "wokwi-led", "id": "led12", "top": 20, "left": 500, "attrs": { "color": "red", "label": "D" } },
    { "type": "wokwi-resistor", "id": "r12", "top": 90, "left": 495, "rotate": 90, "attrs": { "value": "220" } }
  ],

  "connections": [
    // ===== COMUNICACIÓN SERIAL =====
    [ "pico:GP0", "$serialMonitor:RX", "", [] ],
    [ "pico:GP1", "$serialMonitor:TX", "", [] ],

    // ===== CONEXIÓN DEL KEYPAD (COLUMNAS Y FILAS) =====
    // Columnas
    [ "keypad1:C4", "pico:GP16", "green", [] ],
    [ "keypad1:C3", "pico:GP17", "green", [] ],
    [ "keypad1:C2", "pico:GP18", "green", [] ],
    [ "keypad1:C1", "pico:GP19", "green", [] ],

    // Filas
    [ "keypad1:R4", "pico:GP20", "green", [] ],
    [ "keypad1:R3", "pico:GP21", "green", [] ],
    [ "keypad1:R2", "pico:GP22", "green", [] ],
    [ "keypad1:R1", "pico:GP26", "green", [] ],

    // ===== LEDs CONECTADOS A GPIO =====
    // Cada GPIO controla un LED a través de su resistencia
    [ "pico:GP4", "r1:2", "green", [] ],
    [ "pico:GP5", "r2:2", "green", [] ],
    [ "pico:GP6", "r3:2", "green", [] ],
    [ "pico:GP7", "r4:2", "green", [] ],
    [ "pico:GP8", "r5:2", "green", [] ],
    [ "pico:GP9", "r6:2", "green", [] ],
    [ "pico:GP10", "r7:2", "green", [] ],
    [ "pico:GP11", "r8:2", "green", [] ],

    [ "pico:GP3", "r9:2", "green", [] ],
    [ "pico:GP2", "r10:2", "green", [] ],
    [ "pico:GP28", "r11:2", "green", [] ],
    [ "pico:GP27", "r12:2", "green", [] ],

    // ===== TIERRA (GND) =====
    // Todos los cátodos de LEDs van a tierra
    [ "pico:GND.4", "led1:C", "black", [] ],
    [ "pico:GND.4", "led2:C", "black", [] ],
    [ "pico:GND.4", "led3:C", "black", [] ],
    [ "pico:GND.4", "led4:C", "black", [] ],
    [ "pico:GND.4", "led5:C", "black", [] ],
    [ "pico:GND.4", "led6:C", "black", [] ],
    [ "pico:GND.4", "led7:C", "black", [] ],
    [ "pico:GND.4", "led8:C", "black", [] ],
    [ "pico:GND.4", "led9:C", "black", [] ],
    [ "pico:GND.4", "led10:C", "black", [] ],
    [ "pico:GND.4", "led11:C", "black", [] ],
    [ "pico:GND.4", "led12:C", "black", [] ],

    // ===== PULL-UP DEL KEYPAD =====
    // Resistencias conectadas a 3.3V para estabilizar señales
    [ "rp1:1", "rp2:1", "red", [] ],
    [ "rp2:1", "rp4:1", "red", [] ],
    [ "rp4:1", "rp3:1", "red", [] ],
    [ "rp3:1", "pico:3V3", "red", [] ]
  ],

  "dependencies": {}
}
